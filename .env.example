# Copy this file to .env and fill in your values:
#   copy .env.example .env        (Windows)
#
# Only GROQ_API_KEY is required. Everything below it is optional -
# Wave runs fine with just the one line, using sensible defaults for
# everything else.

# ── Required (for the default Groq brain) ──────────────────────────────
# Your Groq API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Which LLM answers - Phase 4 ────────────────────────────────────────
# One line decides it. With nothing below set, Wave uses Groq exactly as before.
#
#   LLM_PROVIDER=groq         # default
#   LLM_PROVIDER=openai       # + OPENAI_API_KEY=sk-...
#   LLM_PROVIDER=openrouter   # + OPENROUTER_API_KEY=sk-or-...
#   LLM_PROVIDER=ollama       # local models via Ollama's OpenAI-compatible /v1 (no key)
#   LLM_PROVIDER=custom       # any OpenAI-compatible server: also set LLM_BASE_URL
#                             #   (LM Studio, vLLM, llama.cpp server, Together, Mistral, ...)
#
# Everything below is optional. LLM_MODEL always wins over a provider's default; model ids
# change quickly, so if you get "model not found", set LLM_MODEL to one your account lists.
# Defaults: groq=openai/gpt-oss-120b (vision: qwen/qwen3.8-27b), openai=gpt-5.4-mini,
# openrouter=openai/gpt-oss-120b, ollama=$OLLAMA_MODEL.
#LLM_PROVIDER=groq
#LLM_API_KEY=            # works for any provider; beats the provider-specific key variables
#LLM_BASE_URL=           # override the endpoint (required for custom)
#LLM_MODEL=
#LLM_VISION_MODEL=       # defaults to LLM_MODEL (groq keeps its own vision model)
#LLM_TIMEOUT=60          # seconds to wait for a reply (ollama default: 120)
#LLM_MAX_RETRIES=2       # for 429 / 5xx / connection resets
#LLM_REASONING_EFFORT=auto   # auto | off | low | medium | high  ("off" never sends it)
#OPENAI_API_KEY=
#OPENROUTER_API_KEY=

# ── Drop-in skills with hot reload - Phase 4 ───────────────────────────
# Put a .py file that uses @skill(...) into user_skills/ and Wave can use it within
# seconds - no restart. See user_skills/_example_skill.py.
#WAVE_USER_SKILLS_DIR=   # default: <data folder>/user_skills
#SKILLS_HOT_RELOAD=true  # false = load the folder once at startup, don't watch it
#SKILLS_POLL_INTERVAL=1.5

# ── How many tools go with each LLM request - Tier 28 ──────────────────
# Wave has 180+ tools; Groq/OpenAI refuse more than 128 in one request, and Groq's
# free tier (8,000 tokens a minute) can't even take that many (~55 tokens each).
# Wave sends the ones the request needs, up to this many. 20 keeps a request near
# 2,700 tokens; on a paid tier you can raise it (max 128). 0 = send all of them.
#LLM_MAX_TOOLS=20

# ── Replies that don't stall on rate limits - Tier 29 ──────────────────
# A "429 Too Many Requests" moves the request straight to a backup model (on Groq each
# model has its own per-minute quota) instead of waiting ~30 s. Blank = openai/gpt-oss-20b
# when the provider is Groq; "off" = no backup.
#LLM_FALLBACK_MODEL=
# Tier 34: everyday turns go to a FAST model, and long / multi-step / code / writing /
# "explain in detail" ones to LLM_MODEL - each Groq model has its own per-minute quota, so
# this spreads the load. It learns: request kinds whose fast answers you correct ("galat
# hai", the same question again) move to LLM_MODEL. Background jobs (memory, reminder
# wording) use the fast model too. Blank = openai/gpt-oss-20b on Groq; "off" = LLM_MODEL only.
#LLM_FAST_MODEL=
#LLM_ROUTER=on              # on | shadow (decide and log, always answer with LLM_MODEL) | off
#LLM_RATE_LIMIT_WAIT_S=10   # if every model is busy but one frees up this soon, wait for it once
#LLM_HISTORY_CHARS=4000     # how much earlier conversation goes with each request
# Tier 38: what drops out of that is folded into a short summary of the conversation
# (one background call to the fast model per few messages) that goes in the prompt.
#LLM_ROLLING_SUMMARY=true
#LLM_SUMMARY_MAX_CHARS=600
# Tier 40: stable, non-personal questions answered before ("what is photosynthesis?") are
# answered again from a cache with no model call. Days an answer is kept:
#LLM_RESPONSE_CACHE=true
#LLM_CACHE_TTL_DAYS=14
# Tier 41: learn whether you like short or detailed answers ("detail mein samjhao",
# "chhota batao", interrupting). Replies always follow your message's script (Hinglish
# in Roman letters stays Roman) either way.
#LLM_STYLE_PROFILE=true
# Web UI mic: short, unsure transcripts without the wake word are treated as room noise,
# and AWAKE goes back to waiting for the wake word after this many quiet seconds.
#AWAKE_MIN_CONFIDENCE=0.5   # 0 = off
#AWAKE_IDLE_SLEEP_S=60      # 0 = stay awake until told to sleep

# ── Action audit + undo - Phase 4 ──────────────────────────────────────
# Files Wave deletes go to its own trash (database/trash) instead of being destroyed, and a file it
# is about to overwrite is backed up first - that is what makes "undo" possible.
#UNDO_TRASH_ENABLED=true   # false = deletes are permanent again (no undo for deletes)
#TRASH_RETENTION_DAYS=7
#UNDO_MAX_FILE_MB=200      # bigger files are deleted for real and the reply says they can't be undone
#AUDIT_MAX_ENTRIES=1000

# ── Where Wave stores its data - Phase 4 ───────────────────────────────
# Running from source: the project folder (nothing changes). In a PyInstaller build: the folder
# next to the .exe, or %LOCALAPPDATA%\WaveAI if that isn't writable. Override with:
#WAVE_DATA_DIR=

# ── Local LLM fallback (Ollama) - Phase 2 ──────────────────────────────
# Used automatically when Groq is unreachable, errors out, or
# GROQ_API_KEY above is left blank. Requires Ollama installed
# (https://ollama.com) with a tool-calling-capable model pulled, e.g.
# `ollama pull llama3.1` - but see OLLAMA_AUTOSTART just below: as of
# Tier 19, Wave can do both of those two steps for you. If Ollama isn't
# installed at all, Wave just skips this tier and falls through to the
# keyword matcher, exactly as it did before this feature existed -
# nothing else to configure.

# Set to false to disable the Ollama fallback entirely.
OLLAMA_ENABLED=true

# Where Ollama is listening. Default is correct for a local install.
OLLAMA_HOST=http://localhost:11434

# Which pulled model to use for the fallback.
OLLAMA_MODEL=llama3.1

# Seconds to wait for a response before giving up on Ollama for that turn.
OLLAMA_TIMEOUT=20

# How long Ollama keeps the model loaded in memory after a request
# (reduces reload latency on the next fallback call).
OLLAMA_KEEP_ALIVE=5m

# ── Ollama lifecycle manager - Tier 19 ──────────────────────────────────
# At startup, if Ollama is relevant (OLLAMA_ENABLED above, or
# LLM_PROVIDER=ollama) and already installed, Wave can start its server
# for you and make sure OLLAMA_MODEL is actually pulled - instead of every
# Ollama call just failing quietly until you notice and do both by hand.
# Entirely a no-op if the `ollama` command isn't on your PATH at all -
# "not installed" costs nothing and stays exactly as free as it was
# before this existed.

# Set to false to never touch `ollama serve` yourself (you start/stop it).
OLLAMA_AUTOSTART=true

# Set to false to start the server but never auto-download a model -
# you'll still need to `ollama pull` it yourself at least once.
OLLAMA_AUTO_PULL_MODEL=true

# Seconds to wait for `ollama serve` to come up after starting it.
OLLAMA_STARTUP_TIMEOUT_S=15

# Seconds to wait for a model pull to finish - generous on purpose, a
# first-time pull can be several GB.
OLLAMA_PULL_TIMEOUT_S=1800

# ── Reminders / Alarms - Phase 2 ───────────────────────────────────────
# How often (seconds) the background poller checks for due reminders.
REMINDER_CHECK_INTERVAL=15

# ── Local speech recognition (faster-whisper) - Phase 3 ────────────────
# Used automatically instead of the Google Web Speech API when available,
# so voice commands keep working offline and without sending audio to
# Google. Requires the 'faster-whisper' package (see requirements.txt);
# the model itself downloads the first time it's actually used. If the
# package isn't installed, this is disabled, or the model can't load,
# Wave just falls back to Google - exactly as it did before this feature
# existed - nothing else to configure.

# Set to false to disable faster-whisper and always use Google STT.
FASTER_WHISPER_ENABLED=true

# "tiny"/"base"/"small"/"medium"/"large-v3" - bigger is more accurate and
# slower. "base" is a reasonable default for a live voice assistant on a
# CPU; try "small" if accuracy matters more than latency on your machine.
FASTER_WHISPER_MODEL=base

# "cpu" or "cuda" (if you have a working NVIDIA/CUDA setup).
FASTER_WHISPER_DEVICE=cpu

# "int8" is the fast, low-memory choice for CPU. Use "float16" if
# FASTER_WHISPER_DEVICE is set to "cuda".
FASTER_WHISPER_COMPUTE_TYPE=int8

# ── Semantic (embeddings-based) long-term memory - Phase 3 ─────────────
# Lets Wave surface remembered facts that are conceptually related to
# what you just said, not only ones that match by exact key - only
# kicks in once you've got more than a handful of things remembered;
# below that, every remembered fact is included anyway. Requires the
# 'sentence-transformers' package (see requirements.txt); the embedding
# model downloads the first time it's actually used. If the package
# isn't installed or fails to load, memory falls back to the plain
# key/value behavior Wave always had - nothing else to configure.

# Set to false to disable semantic recall and always use plain key/value
# memory lookup.
SEMANTIC_MEMORY_ENABLED=true

# ── Real echo cancellation (AEC) - Phase 5 ──────────────────────────────
# Replaces the old "raise the mic's energy threshold while TTS is
# speaking" guess with WebRTC's actual reference-signal-based echo
# cancellation. Requires the 'aec-audio-processing' package AND
# 'sounddevice' (see requirements.txt - both installed by default). If
# either is missing, or this is disabled, Wave falls back to the
# energy-threshold heuristics alone - exactly as it worked before this
# feature existed - nothing else to configure.

# Set to false to disable AEC and always use the energy-threshold guess.
AEC_ENABLED=true

# WebRTC APM's internal processing rate - rarely needs changing.
AEC_SAMPLE_RATE=16000

# Rough round-trip delay (ms) between audio hitting the speaker and its
# echo arriving back at the mic. The default suits a laptop's built-in
# speakers/mic; raise it if echo cancellation seems to lag in testing.
AEC_STREAM_DELAY_MS=80

AEC_ENABLE_NS=true
AEC_ENABLE_AGC=false
AEC_ENABLE_VAD=false

# ── Local neural TTS fallback (optional) - Phase 5 ──────────────────────
# Replaces the old robotic Windows SAPI voice as the FIRST offline
# fallback (used when edge-tts has no internet) with a local neural voice
# (Piper) instead. NOT installed by default - see voice/tts.py's HAS_PIPER
# block for why (unverified Windows wheel coverage, GPL-3.0 license,
# pulls in onnxruntime) - this is a deliberate opt-in, not an oversight.
#
#   pip install piper-tts
#   python -m piper.download_voices en_US-lessac-medium
#   (then point TTS_LOCAL_MODEL_PATH at the downloaded .onnx file)
#
# Falls straight back to SAPI, exactly as before, if piper-tts isn't
# installed or no model path is set.

# Set to false to always use SAPI and skip the Piper lookup entirely.
TTS_LOCAL_ENABLED=true

# Full path to a downloaded Piper voice .onnx file. Left blank, Piper is
# never used, even if installed - UNLESS TTS_LOCAL_AUTO_DOWNLOAD below is on.

# ── Tier 13: download a Piper voice automatically instead of the two
# manual steps above ────────────────────────────────────────────────────
# Only reached when TTS_LOCAL_MODEL_PATH above is blank. Off by default -
# a second, deliberate opt-in (on top of installing piper-tts itself) for
# a ~60MB network download; turning this on IS this project's consent for
# it. The downloaded file is checked against a pinned sha256 - see
# voice/tts.py's PIPER_VOICE_CHECKSUMS and docs/VOICE_LOCAL.md.
TTS_LOCAL_AUTO_DOWNLOAD=false

# Which Piper voice to auto-download - en_US-lessac-medium is the only one
# this project has a pinned checksum for today. A different voice still
# downloads (via piper-tts's own `python -m piper.download_voices`), just
# without that verification - see _verify_piper_voice_checksum()'s docstring.
TTS_LOCAL_DEFAULT_VOICE=en_US-lessac-medium

# Where the download is saved. Blank = <data dir>/voice_models/piper.
TTS_LOCAL_VOICES_DIR=

# How long to wait for the download before giving up.
TTS_LOCAL_DOWNLOAD_TIMEOUT_S=45

TTS_LOCAL_MODEL_PATH=

# ── Tier 13: Kokoro - a second, OPTIONAL local voice that can actually
# speak Hindi (Piper above can't - see voice/tts.py's
# _speak_offline_fallback() docstring) ──────────────────────────────────
# pip install kokoro-onnx
# Off by default: measured on CPU at roughly 2x real time for both
# languages (see docs/VOICE_LOCAL.md) - a real latency tradeoff, not a
# free upgrade, so this is its own deliberate opt-in.
TTS_KOKORO_ENABLED=false

# A bigger download than Piper's single voice (~120MB, two fixed files)
# - its own deliberate opt-in, separate from TTS_LOCAL_AUTO_DOWNLOAD
# above. Checked against a pinned sha256 after downloading - see
# voice/tts.py's KOKORO_FILE_CHECKSUMS and docs/VOICE_LOCAL.md.
TTS_KOKORO_AUTO_DOWNLOAD=false

# Where the two downloaded model files are saved. Blank = <data
# dir>/voice_models/kokoro.
TTS_KOKORO_MODEL_DIR=

# kokoro-onnx's own voice names (Kokoro.get_voices()).
TTS_KOKORO_VOICE_EN=af_heart
TTS_KOKORO_VOICE_HI=hf_alpha

# How long to wait for each of the two files' download before giving up.
TTS_KOKORO_DOWNLOAD_TIMEOUT_S=60

# ── Fast deterministic intent layer - Tier 2 ────────────────────────────
# brain/intent_router.py catches a curated set of unambiguous commands
# ("volume up", "lock my pc", "open chrome", ...) and dispatches them
# straight to the matching skill - same confirm-gate/audit/validation a
# model-chosen tool call gets - instead of spending a Groq/OpenAI
# round-trip confirming what was already obvious.

# Set to false to send every command through the LLM tool-calling loop,
# exactly as Wave behaved before this existed.
INTENT_ROUTER_ENABLED=true

# ── Centralized, rotating logging - Tier 2 ──────────────────────────────
# settings/logging_config.py - replaces the old inline
# logging.basicConfig() call, which had no rotation at all, so a
# long-running install's wave_system.log could grow without bound.
# Defaults below match what that old call effectively did, except for
# rotation, which previously didn't exist.

# Standard logging level names: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Roll wave_system.log over once it reaches this many bytes.
LOG_MAX_BYTES=10485760

# How many rolled-over log files (wave_system.log.1, .2, ...) to keep.
LOG_BACKUP_COUNT=5

# Set to false to log to wave_system.log only, with nothing echoed to the
# console (a --windowed PyInstaller build already has no console to echo
# to, regardless of this setting).
LOG_CONSOLE_ENABLED=true

# ── Voice loop: wake word, streaming, time-to-first-audio - Tier 11 ─────
# See docs/WAKE_WORD.md and docs/TTFA_PROTOCOL.md.
#
# Wake word detection. "auto" uses the on-device openWakeWord model when
# openwakeword is installed (requirements-voice-local.txt) and a model is
# present - Wave ships voice_models/wakewords/hey_wave.onnx - and the
# wake phrase picked in Settings is that model's phrase. Otherwise the
# transcript-based check is used, as before. "transcript" always uses
# speech recognition; "openwakeword" insists on the model.
WAKE_WORD_ENGINE=auto
# Another custom model (.onnx) instead of the bundled "Hey Wave" one.
WAKE_WORD_MODEL_PATH=
# Or one of openWakeWord's pretrained phrases: hey_jarvis, alexa,
# hey_mycroft, hey_rhasspy - downloaded on first use; those models are
# CC BY-NC-SA 4.0 (non-commercial use only).
WAKE_WORD_MODEL_NAME=
# Leave unset to use the model's own recommended threshold (from its
# .json card). Lower = wakes more easily, higher = stricter.
#WAKE_WORD_THRESHOLD=0.5
# A detection weaker than this must ALSO look like the wake phrase in the
# transcript ("hey wave", "hey way"...) - cuts most false wakes. 0 = off,
# 1 = check every detection. Leave unset to use the model card's value.
#WAKE_WORD_CONFIRM_BELOW=0.85
WAKE_WORD_AUTO_DOWNLOAD=true
# While asleep with no on-device model or local recognizer, send captured
# speech to the cloud recognizer just to look for the wake phrase? Default
# no: asleep means nothing you say leaves the machine.
STT_CLOUD_WHILE_ASLEEP=false

# How long one listen() waits for speech to start (seconds). The phrase
# limit only applies to the legacy capture path (CAPTURE_ENGINE=legacy).
STT_PHRASE_TIME_LIMIT_S=15
STT_LISTEN_TIMEOUT_S=1

# Streamed replies: the next sentence is synthesized while the current one
# plays (no network pause between sentences), and the audio device is
# initialised once at start-up instead of inside the first reply.
TTS_PREFETCH_ENABLED=true
TTS_PREFETCH_WAIT_S=15
TTS_WARMUP_ENABLED=true

# Time-to-first-audio for every voice turn, appended to
# <data dir>/database/ttfa.jsonl - read it with
#   python -m telemetry.ttfa_report
TTFA_ENABLED=true
# Somewhere else for that log (default: next to the database).
#TTFA_LOG_PATH=

# ── Capture pipeline - Tier 12 ─────────────────────────────────────────
# See docs/CAPTURE_PIPELINE.md. One microphone stream that stays open while
# the mic is on: echo cancellation on every 20 ms frame, a noise floor that
# follows the room, exact end-of-speech, no fixed phrase cap, recovery from
# an unplugged mic. "auto" falls back to the old speech_recognition capture
# when 'sounddevice' isn't usable; "legacy" forces that old path.
CAPTURE_ENGINE=auto
# Silence that ends a phrase (ms). Lower = faster replies, more risk of
# being cut off mid-thought.
STT_END_SILENCE_MS=450
# Tier 36: a phrase that sounds unfinished ("...aur", "...ki", "remind me to", a trailing
# "...") waits this long for the rest of the sentence, and the two are joined.
STT_CONTINUATION=true
STT_CONTINUATION_WAIT_S=1.6
# Tier 37: names Whisper should spell right - from Wave's memory plus this list
# (comma-separated). STT_VOCABULARY=off turns both off.
#STT_EXTRA_VOCABULARY=Priya, Jaipur, Arijit Singh
#STT_VOCABULARY=auto
# Tier 39: while Wave is AWAKE or speaking, other apps (YouTube, Spotify ...) play at this
# share of their own volume, and get it back after. false = never touch other apps' volume.
#AUDIO_DUCKING=true
#AUDIO_DUCK_LEVEL=0.3
# Audio kept from just before speech started, so the first syllable isn't clipped.
STT_PREROLL_MS=300
# Safety cap only (seconds) - a 30-second command is fine.
STT_MAX_UTTERANCE_S=60
# A rough transcript in the chat while you talk: auto (local Whisper and
# 4+ CPU cores) / on / off.
LIVE_CAPTIONS=auto
# Talking over Wave without saying "Wave" interrupts it when the speech is
# this many dB above the background AND real echo cancellation is running.
# 0 = off (then only "stop", "new question" and "Wave, ..." interrupt).
BARGE_IN_SNR_DB=18
# Whisper transcripts below this confidence count as "didn't catch that".
WHISPER_MIN_CONFIDENCE=0.35
# 1 = faster, 5 = slightly more accurate.
FASTER_WHISPER_BEAM_SIZE=5
# Keep one audio output stream open while Wave talks (no gap between
# sentences, continuous echo reference). Closed after a minute idle.
TTS_PERSISTENT_STREAM=true

# Tier 14: how many seconds a shutdown/restart/sleep/hibernate/log-off has
# before it actually happens - say "cancel shutdown" any time before then.
POWER_ACTION_DELAY_S=15

# ── Tier 20: secret redaction (brain/redaction.py) ───────────────────────
# Scrubs text shaped like an API key/JWT/card number/Aadhaar/PAN/UPI id/etc
# out of log lines, telemetry, and diagnostics reports before they're
# written/shown. true = on (recommended); false restores pre-Tier-20
# behavior (nothing scrubbed).
REDACT_SECRETS_ENABLED=true

# ── Tier 20: security mode (brain/groq_core.py's _guard(), security log) ─
# off      = no extra confirmation beyond Wave's existing per-tool rules.
# standard = the default tier x taint policy (recommended).
# strict   = tighter: more things need a spoken "yes" before running.
SECURITY_MODE=standard

# ── Phase 6: "mere notes se batao" / search_my_notes background index ───
# true = on startup, Wave quietly scans your notes folder(s) and builds a
# small search index in the background so you can ask it to search your
# notes later. On a notes-heavy folder this can print a burst of
# "Batches: 100%" lines (sentence-transformers' own progress bar) while it
# indexes - harmless, but noisy. false = skip this entirely (search_my_notes
# then just says the index is off); startup stays silent either way.
NOTES_RAG_ENABLED=true

# ── Tier 27: lifelike avatar animation (web UI's Dodo page) ─────────────
# Optional. LivePortrait (https://github.com/KwaiVGI/LivePortrait) re-draws
# your avatar photo with real blinks, eye movement, breathing and a mouth
# that moves with Wave's voice. Needs an NVIDIA GPU and its OWN Python
# environment with CUDA PyTorch (several GB - not part of requirements.txt):
#   python -m venv C:\wave_lp\env
#   C:\wave_lp\env\Scripts\pip install torch torchvision --index-url https://download.pytorch.org/whl/cu128
#   git clone https://github.com/KwaiVGI/LivePortrait C:\wave_lp\LivePortrait
#   C:\wave_lp\env\Scripts\pip install opencv-python onnxruntime onnx scikit-image scipy imageio imageio-ffmpeg pyyaml tqdm rich requests
#   huggingface-cli download KwaiVGI/LivePortrait --local-dir C:\wave_lp\LivePortrait\pretrained_weights --include "insightface/*" "liveportrait/*"
# Then Settings -> Avatar -> "Render lifelike animation" (a few minutes,
# once per photo). Left blank, the Dodo page keeps the simple 5-frame avatar.
AVATAR_LIVE_PYTHON=
AVATAR_LIVE_LP_DIR=

# ── Tier 25/31: Wave speaks in YOUR voice (Coqui XTTS-v2 voice cloning) ──
# Optional: `pip install coqui-tts`, then Settings -> Avatar -> "Build avatar"
# with a clean ~20-30s recording of your voice. The first use downloads the
# ~1.8GB model and asks (once, in a console) to accept Coqui's
# non-commercial licence (CPML). false switches cloning off but keeps your sample.
#TTS_CLONE_ENABLED=true
# auto = the NVIDIA GPU when PyTorch has CUDA, else the CPU; cpu / cuda force one.
# Measured on a laptop: a sentence takes ~1.8x its length to make on the CPU
# (i5-13450HX), ~0.4x on an RTX 3050. See docs/VOICE_LOCAL.md for the GPU build.
#TTS_CLONE_DEVICE=auto
# Tier 42: "Systems active." / "Standing by." rendered once in the cloned voice and kept in
# voice_cache/, so they play at once (even right after a restart). false = render each time.
#TTS_CLONE_PREWARM=true
# Tier 43: "open X" launches straight from Windows' list of installed apps (kept in
# app_index.json) instead of typing into the Start menu. false = the old way.
#APP_INDEX=true
# Tier 44: Wi-Fi / Bluetooth on-off and light/dark mode really switched (turning a radio off
# asks first). false = Wave can't switch them.
#SYSTEM_TOGGLES=true
# Tier 45: "make it louder", "the screen is too dark", "skip to the next track" - everyday
# low-risk commands in other words run at once, without a model call (uses the sentence
# model of SEMANTIC_MEMORY_ENABLED). false = such sentences go to the model as before.
#SEMANTIC_INTENTS=true
# Windows 11 slows "background" processes ~15x a second into any heavy work
# (EcoQoS); Wave opts its own process out. false = let Windows throttle it.
#POWER_THROTTLING_OPT_OUT=true

# ── Tier 32: only YOUR voice (voice/speaker_id.py) ─────────────────────
# Wave compares every utterance's voice with your voiceprint - your voice
# training through this PC's mic - and ignores other voices (the TV, videos,
# other people) before even transcribing them. Needs
# `pip install kaldi-native-fbank`, `python scripts/download_speaker_model.py`,
# then `python scripts/train_my_voice.py` (30 s of you through this mic - do it once).
# auto = on once you've trained; off = every voice counts.
#SPEAKER_VERIFY=auto
# 0-1; lower lets more through (you AND others), higher is stricter.
#SPEAKER_VERIFY_THRESHOLD=0.35
