# --- Virtual environment (recreate from requirements.txt, never commit this) ---
wave_env/
venv/
.venv/

# --- Secrets ---
.env

# --- Python cache ---
__pycache__/
*.pyc

# --- Local data & logs (personal, per-machine — not source) ---
database/wave_memory.db
# the log and its rotated copies (.1, .2) - they hold what you said to Wave
wave_system.log*
# what the cloned voice's own process printed (Tier 31)
wave_voice_clone.log*
# what the model router learned from your corrections (Tier 34)
model_router.json
# the running summary of your current conversation (Tier 38)
conversation_summary.json
# other apps' volumes while Wave has them turned down (Tier 39)
audio_ducking.json
# whether you like short or detailed answers, and your usual script (Tier 41)
style_profile.json
# phrases rendered once in the cloned voice (Tier 42) - that voice's audio
voice_cache/
# the installed apps on this PC (Tier 43)
app_index.json
wave_settings.json
database/trash/
database/ttfa.jsonl*
# the avatar: your photo, its frames, your voice sample and the rendered
# lifelike clips (avatar_rig/live/, tens of MB)
avatar_rig/
data/unmatched_utterances.jsonl
user_skills/*.py
!user_skills/_example_skill.py

# --- Bundled Tesseract OCR binaries (large binaries, not source code) ---
*.exe
*.dll
tessdata/
# --- Bundled Tesseract OCR documentation (its own man pages / README / LICENSE —
#     not Wave's docs; committed by accident once) ---
*.1.html
*.5.html

# --- Generated screenshots / webcam photos ---
assets/*.png
assets/*.jpg
screenshots/*.png
screenshots/*.jpg

# --- OS / editor junk ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- PyInstaller build output (docs/PACKAGING.md) - rebuild, don't commit ---
build/
dist/
*.spec.bak
# the shareable zip that clean_zip.py / make_clean_zip.bat builds
wave_project_clean.zip
# --- Downloaded Piper voices (~60 MB each; Wave fetches them itself) ---
voice_models/*.onnx
voice_models/*.onnx.json
voice_models/piper/
piper_voices/
# --- Stray duplicate copies of config files ---
.env ·*
.gitignore ·*
# --- Tier 11: openWakeWord's feature files, downloaded on first use (not ours
#     to redistribute) - Wave's own voice_models/wakewords/hey_wave.onnx IS tracked ---
voice_models/openwakeword/
# --- Tier 32: the speaker model (scripts/download_speaker_model.py fetches it) ---
voice_models/speaker/
